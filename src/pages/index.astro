---
import "../styles/animations.css";
import "../styles/global.css";
import "../styles/dialog.css";
import Footer from "../sections/Footer.astro";
import Sobre from "../sections/Sobre.astro";
import Menu from "../sections/Menu.astro";
import Drumkit from "../components/Drumkit.astro";
---
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jersey+15&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Geist+Pixel&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=BioRhyme:wght@200..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Music&display=swap" rel="stylesheet">
		<link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
		<meta name="generator" content={Astro.generator} />
		<title>Diegnóstico</title>
	</head>

	<body>
    <Drumkit />
    <div class="container-info">
      <h1>Olá, eu sou o Diego Rapoport!</h1>
      <div class="img-menu">
        <img id="pixel-di" src="src/assets/pixeldi.png">
        <aside class="not-ready"><Menu /></aside>
      </div>
    </div>
    <Sobre />
    <Footer />
	</body>
</html>
