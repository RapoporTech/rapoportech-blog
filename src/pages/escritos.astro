---
import "../styles/global.css";
import "../layouts/layout-styles.css";
import { getCollection } from "astro:content";
import { isPublished } from "../lib/publishing.ts";
import EscritosLayout from "../layouts/EscritosLayout.astro";

const allPosts = (await getCollection("escritos"))
  .filter(isPublished)
  .sort((a, b) => b.data.dataPub.valueOf() - a.data.dataPub.valueOf());
---

<script>
  const letra = (char, i) => {
    const span = document.createElement("span");
    span.className = "letra";
    span.style.setProperty("--i", i);
    span.textContent = char;
    if (char === " ") span.style.padding = ".2rem";
    return span;
  };

  document.querySelectorAll(".type-fade-right").forEach((el) => {
    const palavras = el.textContent.split(" ");
    el.textContent = "";
    let i = 0;

    palavras.forEach((palavra, n) => {
      if (n > 0) el.appendChild(letra(" ", i++));
      const grupo = document.createElement("span");
      grupo.className = "palavra";
      [...palavra].forEach((char) => grupo.appendChild(letra(char, i++)));
      el.appendChild(grupo);
    });
  });
</script>

<EscritosLayout titulo="Escritos">
  <h1>Deleite-se, Irrite-se, Reconstrua-se</h1>
  <ul>
    {
      allPosts.map((post) => (
        <li>
          <a class="type-fade-right" href={`/escritos/${post.id}`}>
            {post.data.titulo}
          </a>
        </li>
      ))
    }
  </ul>
</EscritosLayout>
